# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=5

# PostgreSQL / Supabase
# Preferred: use DATABASE_URL from Supabase Connection String.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase Storage (project URL + service_role key from Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional fallback (used only if DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_POOL_SIZE=10
DB_SSL=true

# Frontend
VITE_API_URL=http://localhost:4000

# Recruiter panel (/painel.html) - Supabase Auth
# WARNING: this is the ANON key (Project Settings > API > anon public), which is
# safe to ship in the browser bundle. NEVER put the service_role key in a
# VITE_-prefixed variable: it bypasses Row Level Security and would be published
# with the static site.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# How long a resume download link stays valid, in seconds (default: 300)
RESUME_URL_TTL_SECONDS=300

